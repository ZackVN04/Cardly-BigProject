# ===== Global =====
ENVIRONMENT=local
APP_VERSION=1.0.0
MONGODB_URL=
REDIS_URL=
CORS_ORIGINS=
# ===== Auth (P1) =====
JWT_SECRET=change-me-in-prod
JWT_ALG=HS256
JWT_EXP=15
REFRESH_TOKEN_EXP=7
OTP_EXP_MINUTES=10

# ===== SMTP (for OTP emails — use Gmail App Password or Mailpit for dev) =====
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

EMAIL_FROM=
EMAIL_FROM_NAME=

# ===== Intake (P2) =====
MAX_SIZE_MB=10
STORAGE_PATH=/tmp/ocr_uploads

# ===== Preprocess (P3) =====
MIN_DPI=300

# ===== OCR (P4) =====
GEMINI_API_KEY=your-gemini-api-key-here
OCR_ENGINE=gemini

# ===== Confidence (P6) =====
HIGH_THRESHOLD=0.95
LOW_THRESHOLD=0.70

# ===== GCS / Google Cloud =====
# Paste the full service account JSON as a single-line value
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}
