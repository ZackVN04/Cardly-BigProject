# ===== Global =====
ENVIRONMENT=local
APP_VERSION=1.0.0
MONGODB_URL=mongodb+srv://Admin:Admin123@ocrbigproject.vtuevlr.mongodb.net/?appName=OCRBigProject
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000"]

# ===== Auth (P1) =====
JWT_SECRET=change-me-in-prod
JWT_ALG=HS256
JWT_EXP=15
REFRESH_TOKEN_EXP=7
OTP_EXP_MINUTES=10

# ===== SMTP (for OTP emails — use Gmail App Password or Mailpit for dev) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=okihawa4@gmail.com
SMTP_PASSWORD=abcdsmqphvtoswrq

EMAIL_FROM=okihawa4@gmail.com
EMAIL_FROM_NAME=cardly

# ===== Intake (P2) =====
MAX_SIZE_MB=10
STORAGE_PATH=/tmp/ocr_uploads

# ===== Preprocess (P3) =====
MIN_DPI=300

# ===== OCR (P4) =====
GEMINI_API_KEY=your-gemini-api-key-here
OCR_ENGINE=gemini

# ===== Confidence (P6) =====
HIGH_THRESHOLD=0.95
LOW_THRESHOLD=0.70

# ===== GCS / Google Cloud =====
